# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 数据源：tencent（腾讯财经公开行情，默认）| mock（离线模拟数据，用于演示/开发）
DATA_PROVIDER=tencent

# 交易时段内行情轮询间隔（毫秒，最小 500）
QUOTE_INTERVAL_MS=2000
# 休市时段行情轮询间隔（毫秒）
IDLE_QUOTE_INTERVAL_MS=30000

# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# 单个连接最多订阅的代码数量
MAX_SUBSCRIPTIONS=300
# 所有连接合计订阅的不同代码数上限
MAX_TOTAL_SYMBOLS=3000
# 同一 IP 同时保持的 WebSocket 连接数上限
MAX_CONNECTIONS_PER_IP=20
# 允许跨域连接 WebSocket 的页面来源（逗号分隔），同源页面始终允许
# ALLOWED_ORIGINS=https://example.com
